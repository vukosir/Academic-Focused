# Required in production: a long random string (at least 32 characters) that signs
# sessions and encrypts two-step verification secrets. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep it out of source control. Changing it signs everyone out and invalidates
# existing two-step verification setups.
AUTH_SECRET=
# Public URL of the site, https:// in production (used in password reset links)
APP_URL=http://localhost:3000
# Where the JSON database and security log live (default: ./data).
# Put it on a persistent, backed-up volume that only the app's user can read.
DATA_DIR=
PORT=3000
# Set to 1 only when the app runs behind a CDN or reverse proxy that sets
# X-Forwarded-For; otherwise that header could be faked to dodge rate limits.
TRUST_PROXY=
# Set to 1 to print password reset links to the server log in production
# (there is no email service yet). Off by default.
RESET_LINKS_TO_LOG=
# Admins are not set here. After you create your account on the site, run on
# the server:  npm run admin -- grant vukosir@icloud.com
